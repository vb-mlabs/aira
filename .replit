# Replit configuration for the MLabs template.
#
# Deployment target: Reserved VM. Autoscale is incompatible
# with our polling endpoints because each polling request would cold-start.

run = "pnpm dev"
entrypoint = "apps/web/src/app/page.tsx"
modules = ["nodejs-20"]

hidden = [".next", "node_modules", ".cache", ".lefthook"]

[nix]
channel = "stable-24_05"

[deployment]
deploymentTarget = "vm"
build = ["sh", "-c", "rm -rf apps/web/.next && pnpm install --frozen-lockfile=false && pnpm --filter @aira/db migrate && pnpm --filter @aira/web build && cp -r apps/web/public apps/web/.next/standalone/apps/web/public-runtime && rm -rf apps/web/.next/standalone/apps/web/public && mv apps/web/.next/standalone/apps/web/public-runtime apps/web/.next/standalone/apps/web/public && cp -r apps/web/.next/static apps/web/.next/standalone/apps/web/.next/static && NODE_VER=20.18.1 && NODE_TARBALL=\"node-v${NODE_VER}-linux-x64.tar.xz\" && curl -fsSL \"https://nodejs.org/dist/v${NODE_VER}/${NODE_TARBALL}\" -o \"/tmp/${NODE_TARBALL}\" && curl -fsSL \"https://nodejs.org/dist/v${NODE_VER}/SHASUMS256.txt\" -o /tmp/SHASUMS256.txt && (cd /tmp && grep \" ${NODE_TARBALL}$\" SHASUMS256.txt | sha256sum -c -) && tar -xJf \"/tmp/${NODE_TARBALL}\" -C /tmp && cp \"/tmp/node-v${NODE_VER}-linux-x64/bin/node\" apps/web/.next/standalone/node-runtime && chmod +x apps/web/.next/standalone/node-runtime && rm -rf \"/tmp/node-v${NODE_VER}-linux-x64\" \"/tmp/${NODE_TARBALL}\" /tmp/SHASUMS256.txt && node scripts/deploy-prune.cjs"]
run = ["sh", "-c", "PORT=5000 HOSTNAME=0.0.0.0 exec ./apps/web/.next/standalone/node-runtime apps/web/.next/standalone/apps/web/server.js"]

[env]
# SKIP_ENV_VALIDATION is set during build only; runtime validates fully.
NEXT_TELEMETRY_DISABLED = "1"
# Safety net — if any transitive dep ever postinstalls Playwright,
# skip the ~1 GB Chromium download. The deploy image doesn't need it.
PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD = "1"

[agent]
expertMode = true
stack = "BEST_EFFORT_FALLBACK"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Claude bootstrap"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash .claude/scripts/setup-memory.sh"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @aira/web dev -p 5000 -H 0.0.0.0"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow]]
name = "Expo Go (Tunnel)"
mode = "sequential"
author = "agent"

# EXPO_FORCE_WEBCONTAINER_ENV=1 routes the tunnel through Expo's hosted
# ws-tunnel backend (*.boltexpo.dev) instead of @expo/ngrok. Ngrok deprecated
# anonymous tunnels upstream, so without this flag Expo CLI falls back to
# ngrok and crashes mid-startup with
# `TypeError: Cannot read properties of undefined (reading 'body')` (CLI
# misreads ERR_NGROK_4018 "auth required"). Setting this env var flips
# Expo CLI's `envIsWebcontainer()` check to true and uses ws-tunnel, which is
# free + anonymous + zero-config. Healthy startup logs
# `Waiting on http://<id>.boltexpo.dev` followed by the QR code. See
# CLAUDE.md "Expo Go on Replit".
[[workflows.workflow.tasks]]
task = "shell.exec"
args = "EXPO_FORCE_WEBCONTAINER_ENV=1 pnpm --filter @aira/mobile exec expo start --tunnel --clear"

[[ports]]
localPort = 3000
externalPort = 3000

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 8080
externalPort = 8080

[objectStorage]
defaultBucketID = "replit-objstore-7ec03186-b4ed-4cae-b991-c9abd53c4c54"
